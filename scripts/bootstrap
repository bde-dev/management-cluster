#!/bin/bash

# Bootstrap ArgoCD into a Talos cluster

: "${CLIENT_ID:?Missing CLIENT_ID}"
: "${CLIENT_SECRET:?Missing CLIENT_SECRET}"
: "${GITHUB_USERNAME:?Missing GITHUB_USERNAME}"
: "${GITHUB_PAT_TOKEN:?Missing GITHUB_PAT_TOKEN}"
: "${KUBECONFIG:?Missing KUBECONFIG}"

kubectl config current-context

read -p "Press enter to bootstrap ArgoCD to the above context or ctrl+C to exit."

echo "Creating namespaces"

kubectl create namespace argocd
kubectl create namespace external-secrets

echo "Creating azure-creds"

cat <<EOF | kubectl apply -f -
apiVersion: v1
Kind: Secret
metadata:
  name: azure-creds
  namespace: external-secrets
type: Opaque
stringData:
  ClientID: ${CLIENT_ID}
  ClientSecret: ${CLIENT_SECRET}
EOF

echo "Creating argocd-management-repo-creds-github"

cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: argocd-management-repo-creds-github
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/bde-dev/management-cluster.git
  username: ${GITHUB_USERNAME}
  password: ${GITHUB_PAT_TOKEN}
EOF

echo "Attempting helm installation"

helm repo add argo https://argoproj.github.io/argo-helm
helm repo update
helm install argocd argo/argo-cd \
  --namespace argocd \
  --version 9.3.7 \
  --set configs.cm.kustomize.buildOptions="--enable-helm" \
  --set configs.params.server.insecure="true"

echo "Creating project and root app"

kubectl apply -f projects/management.yaml
kubectl apply -f management-root-app.yaml

echo "Done"
