#!/bin/bash

# Bootstrap ArgoCD into a Talos cluster

if [[ -z $GITHUB_USERNAME ]] || [[ -z $GITHUB_PAT_TOKEN ]] || [[ -z $KUBECONFIG ]]; then
  echo "Error: GITHUB_USERNAME, GITHUB_PAT_TOKEN, KUBECONFIG must be set"
  exit 1
fi

kubectl config current-context

read -p "Press enter to bootstrap ArgoCD to the above context or ctrl+C to exit."

kubectl create namespace argocd

cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: argocd-management-repo-creds-github
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/bde-dev/management-cluster.git
  username: ${GITHUB_USERNAME}
  password: ${GITHUB_PAT_TOKEN}
EOF

helm repo add argo https://argoproj.github.io/argo-helm
helm repo update
helm install argocd argo/argo-cd \
  --namespace argocd \
  --values ./argocd/values.yaml
